  "assumptions": [
    {
      "id": "0a1ad1d2-151f-4b6c-9a60-752442b25534",
      "kind": "enunciado",
      "text": "Un mismo nivel puede existir para idiomas distintos y la escuela no oferta todos los niveles de todos los idiomas.",
      "elementId": "d1034581-0d0d-4a09-a7a0-737d586fd016"
    },
    {
      "id": "c526c6f3-f65f-45f4-a5cd-713bcde19658",
      "kind": "supuesto",
      "text": "Cada combinación ofertada de idioma y nivel es un Curso con código propio; la pareja idioma–nivel es clave alternativa para no repetirla.",
      "elementId": "d1034581-0d0d-4a09-a7a0-737d586fd016"
    },
    {
      "id": "cdf6ea02-434c-476b-a579-6036718bfb9b",
      "kind": "supuesto",
      "text": "El alumno se matricula en cursos, no en idiomas y niveles sueltos; la calificación es un atributo de la matrícula.",
      "elementId": "270a70ab-03a7-45a9-93b3-339a7df17cb8"
    },
    {
      "id": "89f98999-90ca-49b8-93bd-f100221964df",
      "kind": "supuesto",
      "text": "Un alumno se matricula al menos de un curso.",
      "elementId": "ce67d1d9-6a28-4a4b-b84a-f8afbd301bbd"
    },
    {
      "id": "ae51c20a-2294-462d-aef9-2d0716e54a9d",
      "kind": "perdida",
      "text": "Si un alumno repite curso en años distintos haría falta el año en la clave de la matrícula; el enunciado no lo pide.",
      "elementId": "270a70ab-03a7-45a9-93b3-339a7df17cb8"
    }
  ],
