  "assumptions": [
    {
      "id": "4dbeaaa0-b942-4976-90e1-b48e853079d6",
      "kind": "enunciado",
      "text": "Todos los vehículos son camión, furgoneta o coche de empresa, cada uno con su dato propio: especialización total y disjunta.",
      "elementId": "bf1e82a7-4935-4390-850d-c396db643b50"
    },
    {
      "id": "3a98e636-dd0f-411d-99c1-0ed031534e39",
      "kind": "enunciado",
      "text": "Todo empleado pertenece obligatoriamente a un departamento, cuyo nombre no se repite.",
      "elementId": "e4354437-0fc1-41c8-85c6-307332eb72b6"
    },
    {
      "id": "0591b1d4-0ab1-4dc8-9630-06ab0bdb23e2",
      "kind": "supuesto",
      "text": "Los empleados \"pueden ser\" conductores o administrativos: especialización parcial y disjunta.",
      "elementId": "0ab457fd-8290-47cb-9fe0-375cc8535f8a"
    },
    {
      "id": "b3831aca-a5ca-48ed-bd7f-de14df73de46",
      "kind": "supuesto",
      "text": "La asignación de vehículos es para conductores, en turnos: el turno forma parte de la clave y un mismo conductor puede llevar el mismo vehículo en turnos distintos.",
      "elementId": "d393e060-adf5-4b7b-925a-cd3f5cc14bd7"
    },
    {
      "id": "97dfe7a0-191f-48e7-924b-7203da32249d",
      "kind": "perdida",
      "text": "Que dos conductores no lleven el mismo vehículo en el mismo turno y día no se impone; habría que añadir la fecha.",
      "elementId": "d393e060-adf5-4b7b-925a-cd3f5cc14bd7"
    }
  ],
