  "assumptions": [
    {
      "id": "9b2e2fe2-2d34-40e3-99eb-8390c35e5cf0",
      "kind": "enunciado",
      "text": "Todos los vehículos son camión, furgoneta o coche de empresa, cada uno con su dato propio: especialización total y disjunta.",
      "elementId": "8fceef4e-ddc7-421c-be24-0c9d34a59698"
    },
    {
      "id": "434d93a5-4f3b-4c4e-9495-0e9c1807ac74",
      "kind": "enunciado",
      "text": "Todo empleado pertenece obligatoriamente a un departamento, cuyo nombre no se repite.",
      "elementId": "68ab253a-0599-43ff-a800-ac32b372a52a"
    },
    {
      "id": "140b0291-71dd-448a-b5a0-8924cb3e14d2",
      "kind": "supuesto",
      "text": "Los empleados \"pueden ser\" conductores o administrativos: especialización parcial y disjunta.",
      "elementId": "455a83c1-25b6-40cc-aa12-4bf3e88f25e3"
    },
    {
      "id": "d5b91cb8-3052-4840-9cc6-6027b38e0a50",
      "kind": "enunciado",
      "text": "Un vehículo lo usan conductores distintos en turnos distintos: en cada turno tiene un solo conductor, así que la clave de la asignación es (vehículo, turno) y el conductor es una clave ajena obligatoria fuera de la clave.",
      "elementId": "eb8ca022-a10e-4a3c-9245-8d6cffa6d71d"
    },
    {
      "id": "bd6f2dba-1239-4a92-9b22-cc368b172f3d",
      "kind": "supuesto",
      "text": "Un conductor lleva un solo vehículo en cada turno: clave alternativa (conductor, turno).",
      "elementId": "eb8ca022-a10e-4a3c-9245-8d6cffa6d71d"
    },
    {
      "id": "17097874-3112-47a7-a948-17cd9b002626",
      "kind": "supuesto",
      "text": "Los turnos (mañana, tarde, noche) son un horario fijo que se repite cada día; si la asignación cambiara de un día a otro, la fecha entraría en la clave.",
      "elementId": "eb8ca022-a10e-4a3c-9245-8d6cffa6d71d"
    },
    {
      "id": "a4c1dd1c-ae2b-48aa-8359-f65b2e1f5ae2",
      "kind": "perdida",
      "text": "Que todo vehículo sea exactamente de un tipo (especialización total y disjunta) no lo imponen las claves: un vehículo podría quedar sin subtabla o en dos.",
      "elementId": "8fceef4e-ddc7-421c-be24-0c9d34a59698"
    }
  ],
