  "assumptions": [
    {
      "id": "bbe2e669-95d9-48c2-9450-7c06481d5ad8",
      "kind": "enunciado",
      "text": "Cada hotel tiene un nombre único: clave alternativa sobre el nombre.",
      "elementId": "d650414a-bb71-4115-9873-5d1fa1febbca"
    },
    {
      "id": "feaeae16-0d40-4b1d-a66b-73599c36f91d",
      "kind": "enunciado",
      "text": "Las habitaciones se identifican por su número dentro de cada hotel: entidad débil con clave parcial.",
      "elementId": "a275e3cc-6761-4f95-8866-9b647055b11b"
    },
    {
      "id": "520231f7-b4b5-47f6-900e-a3d118ea1370",
      "kind": "enunciado",
      "text": "La factura se identifica por un número correlativo dentro de la reserva: entidad débil de Reserva.",
      "elementId": "d9d44851-c658-40b1-a138-10ae5c1f83fc"
    },
    {
      "id": "dce210f6-3605-48f1-813c-d0ec0ce51da2",
      "kind": "supuesto",
      "text": "Se añade un código de reserva porque el enunciado no identifica las reservas.",
      "elementId": "d3acdbde-5a1d-4fd5-9bd0-1c9f87dfeba1"
    },
    {
      "id": "d63034b1-2b43-4363-9683-adb2c660349e",
      "kind": "supuesto",
      "text": "Una habitación puede aparecer en varias reservas en intervalos distintos; la relación es N:N.",
      "elementId": "f142b9fd-95f1-404d-8d79-d64d5957a15a"
    },
    {
      "id": "5b5a896f-d210-4978-ba78-952dcd5a9a43",
      "kind": "supuesto",
      "text": "Todo empleado es recepcionista o camarero: clasificación total y disjunta.",
      "elementId": "5196db24-934a-4456-9f69-e6413f5953cd"
    },
    {
      "id": "c14d502f-af73-4415-b96f-89cfc62af426",
      "kind": "perdida",
      "text": "Que dos reservas no solapen fechas sobre la misma habitación no se expresa con claves; queda como restricción documental.",
      "elementId": "f142b9fd-95f1-404d-8d79-d64d5957a15a"
    },
    {
      "id": "2a374cfe-de34-4db5-8f01-44aecaf87b3b",
      "kind": "perdida",
      "text": "Que la categoría sea de 1 a 5 estrellas y que la fecha de fin no preceda a la de inicio quedan como dominios (CHECK).",
      "elementId": "d3acdbde-5a1d-4fd5-9bd0-1c9f87dfeba1"
    }
  ],
