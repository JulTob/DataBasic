  "assumptions": [
    {
      "id": "0a6951d3-d885-4236-b23a-6b83e17f0c24",
      "kind": "enunciado",
      "text": "Puede haber películas con igual título pero distinto año: la clave es (título, año de estreno).",
      "elementId": "3c40ef46-50d9-4eca-933a-47751e71e604"
    },
    {
      "id": "bff20377-4b02-4c00-a374-63a3cf6d860e",
      "kind": "enunciado",
      "text": "Las copias se numeran dentro de cada película: entidad débil con clave parcial.",
      "elementId": "6e80a01e-2997-4c7a-8b8b-393663fc5834"
    },
    {
      "id": "c52d1d09-f3f5-41f0-9cd2-789124fdccef",
      "kind": "supuesto",
      "text": "Los actores principales se guardan como atributo multivaluado, traducido a la tabla Actores.",
      "elementId": "3c40ef46-50d9-4eca-933a-47751e71e604"
    },
    {
      "id": "848fb0f3-cc42-4097-9be3-bd7f7aa94e73",
      "kind": "supuesto",
      "text": "Una misma copia se alquila como mucho una vez al día: la clave del alquiler es (copia, fecha) y el cliente es una clave ajena obligatoria fuera de la clave.",
      "elementId": "5a2ca0d6-edee-428a-a03c-1967bdbe51c9"
    },
    {
      "id": "8dc91a49-b131-49a4-b99c-ca063d666d6c",
      "kind": "enunciado",
      "text": "Un cliente puede realizar varios alquileres en un día: el cliente no forma parte de la clave, así que puede repetirse con la misma fecha.",
      "elementId": "5a2ca0d6-edee-428a-a03c-1967bdbe51c9"
    },
    {
      "id": "562e47b9-b00a-4466-93d9-5a4f145996df",
      "kind": "perdida",
      "text": "La devolución del alquiler no figura en el enunciado y no se modela.",
      "elementId": "5a2ca0d6-edee-428a-a03c-1967bdbe51c9"
    }
  ],
