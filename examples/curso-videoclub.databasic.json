  "assumptions": [
    {
      "id": "dca2477b-ec47-426f-bbc9-101bff8da584",
      "kind": "enunciado",
      "text": "Puede haber películas con igual título pero distinto año: la clave es (título, año de estreno).",
      "elementId": "323bc68a-67cd-4955-96b0-07961aea6476"
    },
    {
      "id": "6f805122-ff24-4656-a5ca-c54beb8cc5cc",
      "kind": "enunciado",
      "text": "Las copias se numeran dentro de cada película: entidad débil con clave parcial.",
      "elementId": "6c7ae3fb-a668-4a48-9330-f48a4e645cb3"
    },
    {
      "id": "e72f9278-0391-4b7e-87b1-344a46a344dc",
      "kind": "supuesto",
      "text": "Los actores principales se guardan como atributo multivaluado, traducido a la tabla Actores.",
      "elementId": "323bc68a-67cd-4955-96b0-07961aea6476"
    },
    {
      "id": "562423a8-a941-4b1c-8f82-25106aa03f35",
      "kind": "supuesto",
      "text": "Una misma copia se alquila como mucho una vez al día: la fecha forma parte de la clave del alquiler.",
      "elementId": "9422ba8a-2401-4cbf-907a-b37a75acea58"
    },
    {
      "id": "fa3b998a-f649-47b9-987a-15ac97e649c4",
      "kind": "perdida",
      "text": "La devolución del alquiler no figura en el enunciado y no se modela.",
      "elementId": "9422ba8a-2401-4cbf-907a-b37a75acea58"
    }
  ],
