  "assumptions": [
    {
      "id": "cf6fdd13-98bb-4381-bd9a-91fc6fcd736c",
      "kind": "enunciado",
      "text": "Los coches que el concesionario vende son nuevos o usados, con sus datos propios: especialización disjunta.",
      "elementId": "81e67950-991c-4136-bd52-5bffc66fb214"
    },
    {
      "id": "1fb7a94d-6d9e-4324-8199-13a43f4fe12c",
      "kind": "supuesto",
      "text": "La especialización es parcial: los coches de clientes que llegan al taller sin haberse vendido aquí se registran solo como Coche.",
      "elementId": "81e67950-991c-4136-bd52-5bffc66fb214"
    },
    {
      "id": "36e0039d-61eb-44d7-81dd-93f92f3c15b6",
      "kind": "enunciado",
      "text": "Un mecánico repara varios coches y un coche lo reparan varios mecánicos; se guarda la fecha y las horas.",
      "elementId": "2d1cb9de-64af-4a03-a748-fb51348ffe44"
    },
    {
      "id": "eed38800-1806-4add-b7ec-204403428665",
      "kind": "supuesto",
      "text": "La fecha forma parte de la clave de la reparación: el mismo mecánico puede reparar el mismo coche en días distintos.",
      "elementId": "2d1cb9de-64af-4a03-a748-fb51348ffe44"
    },
    {
      "id": "5fc4c910-1a2c-4c2c-9180-02095f051de5",
      "kind": "supuesto",
      "text": "Un coche aún no vendido, o que solo pasa por el taller, no tiene comprador: la clave ajena al cliente admite nulos.",
      "elementId": "ff16eb22-8ff7-49ca-941d-64d8071cce71"
    },
    {
      "id": "483e433a-fd5d-45e8-87ab-75124bc80103",
      "kind": "supuesto",
      "text": "El cliente solo se registra cuando compra: participación (1,N) en Compra.",
      "elementId": "df844682-b8ca-47f6-a3f8-7da1ae9a9675"
    },
    {
      "id": "b20f303e-21aa-4ca7-a390-ab264deecde5",
      "kind": "supuesto",
      "text": "Las unidades de un coche nuevo se leen como las existencias de ese mismo modelo en el concesionario, como pide el apartado d; un diseño más fino separaría una entidad Modelo.",
      "elementId": "55e63c36-aafa-4fb4-828d-63a5829b3e4e"
    },
    {
      "id": "c1d9b2c1-910a-46df-a15e-3a70f998f4f4",
      "kind": "perdida",
      "text": "Que un coche no esté a la vez en Nuevo y en Usado (especialización disjunta) no lo imponen las claves.",
      "elementId": "81e67950-991c-4136-bd52-5bffc66fb214"
    }
  ],
