  "assumptions": [
    {
      "id": "8c4e1195-ca33-4631-9887-1afa90d26088",
      "kind": "enunciado",
      "text": "El paciente se identifica por su número de historia clínica; cada ingreso, por un número de secuencia dentro de ella.",
      "elementId": "f79c06a8-49e0-498a-aa4d-c6d9bae685aa"
    },
    {
      "id": "748085b7-c86d-4321-8a1c-1bcf853a6aa5",
      "kind": "enunciado",
      "text": "Hay consumos por paciente (de un ingreso) y consumos generales de cada servicio con su fecha.",
      "elementId": "63054052-4a1d-4d30-8089-14e3bcc55e0d"
    },
    {
      "id": "4b95df91-3cbc-4b6c-9cc3-4afcb7e03f4a",
      "kind": "enunciado",
      "text": "El precio total por envase se obtiene de las dosis por envase y el precio por dosis: atributo derivado que no se almacena.",
      "elementId": "9ba17fab-41c8-46c3-96c7-c966827e7393"
    },
    {
      "id": "edbcb9d0-1f29-438c-87ab-72ca67941b94",
      "kind": "supuesto",
      "text": "El servicio se identifica por un código; su nombre es único.",
      "elementId": "9cb9a94a-deb3-4654-8fac-cf61154b1fc8"
    },
    {
      "id": "74fa1b91-4d40-4878-a572-b65cbc6cfba1",
      "kind": "supuesto",
      "text": "El consumo de un paciente también lleva fecha, que forma parte de la clave: el mismo fármaco puede darse en días distintos del ingreso.",
      "elementId": "b4a93053-7c59-4d1b-b416-f271fa000892"
    },
    {
      "id": "c58e6ce2-ac72-40ab-94ba-b604986dccfc",
      "kind": "supuesto",
      "text": "El número de la Seguridad Social es opcional (\"si lo tuviera\"), así que no puede ser clave alternativa.",
      "elementId": "73ee61ad-c4f3-4974-b3a0-7c64eaac654c"
    },
    {
      "id": "82706fa8-a799-4f62-bd8e-8d7e8564ed6f",
      "kind": "perdida",
      "text": "Los informes de gasto por paciente, servicio o diagnóstico son consultas sobre estas tablas, no datos almacenados.",
      "elementId": "9ba17fab-41c8-46c3-96c7-c966827e7393"
    },
    {
      "id": "04d86d81-a87c-44eb-b639-a35e800feac5",
      "kind": "perdida",
      "text": "Que el número de la Seguridad Social sea único cuando existe no se impone.",
      "elementId": "73ee61ad-c4f3-4974-b3a0-7c64eaac654c"
    }
  ],
