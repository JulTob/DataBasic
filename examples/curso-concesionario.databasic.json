  "assumptions": [
    {
      "id": "8f77c469-9bf2-4f2e-ba57-bba496c283da",
      "kind": "enunciado",
      "text": "Los coches son nuevos o usados, con sus datos propios: especialización total y disjunta.",
      "elementId": "d66b3816-5493-4ee7-9c4d-d94911a50d91"
    },
    {
      "id": "c0fcd31c-fecb-42fa-9a2a-be6b6fcabf57",
      "kind": "enunciado",
      "text": "Un mecánico repara varios coches y un coche lo reparan varios mecánicos; se guarda la fecha y las horas.",
      "elementId": "3c134fb8-5deb-40a2-afc6-81eee4195ce6"
    },
    {
      "id": "a106c1cc-3101-4827-b7a8-a704b9c3fd4d",
      "kind": "supuesto",
      "text": "La fecha forma parte de la clave de la reparación: el mismo mecánico puede reparar el mismo coche en días distintos.",
      "elementId": "3c134fb8-5deb-40a2-afc6-81eee4195ce6"
    },
    {
      "id": "9a30b70b-7a5b-4708-bb9b-564d29f77c2a",
      "kind": "supuesto",
      "text": "Un coche aún no vendido no tiene comprador: la clave ajena al cliente admite nulos. Los coches que llegan al taller se registran como Coche.",
      "elementId": "4ed9844f-a818-43b4-9073-f9783a4b0a29"
    },
    {
      "id": "da8a13c3-ebf6-46e3-b575-dade8c88a6bd",
      "kind": "supuesto",
      "text": "El cliente solo se registra cuando compra: participación (1,N) en Compra.",
      "elementId": "9045955e-53eb-41e9-a29a-90169b22185e"
    },
    {
      "id": "1f79e0b2-1bb6-45ef-b38d-66bbdbe5533c",
      "kind": "perdida",
      "text": "Las unidades en stock de un coche nuevo describen un modelo más que un coche con matrícula; el enunciado mezcla ambos conceptos.",
      "elementId": "ef2cd323-517f-47ca-b4c2-521352ae02c1"
    }
  ],
