  "assumptions": [
    {
      "id": "6e20822b-e22f-435d-984d-8981fd982797",
      "kind": "enunciado",
      "text": "Entidades: libros, autores y usuarios. Relaciones: un autor escribe libros y un usuario toma libros en préstamo.",
      "elementId": "0e4d66d1-08aa-452b-8806-ae854362a61a"
    },
    {
      "id": "afdd0c2a-2d4e-4c9e-8cce-a793091077b6",
      "kind": "supuesto",
      "text": "Un libro tiene uno o varios autores y un autor escribe uno o varios libros: N:N.",
      "elementId": "f964908c-0e0f-43b7-a058-69be56f3706e"
    },
    {
      "id": "6eb454d9-e927-4573-806e-2aa8668de1d6",
      "kind": "supuesto",
      "text": "El préstamo guarda las fechas; la de préstamo forma parte de la clave para que un usuario pueda volver a tomar el mismo libro.",
      "elementId": "be29c7fb-e88a-48e2-8b68-df17308cf2b4"
    },
    {
      "id": "690962f4-8e94-4413-bc92-918479553fcc",
      "kind": "perdida",
      "text": "Se presta el libro, no un ejemplar concreto: con varios ejemplares haría falta la entidad débil Ejemplar.",
      "elementId": "be29c7fb-e88a-48e2-8b68-df17308cf2b4"
    },
    {
      "id": "7309ac9a-0a11-4f94-ac27-e514162815d4",
      "kind": "perdida",
      "text": "Que un mismo libro no esté prestado a dos usuarios a la vez no se impone con claves.",
      "elementId": "be29c7fb-e88a-48e2-8b68-df17308cf2b4"
    }
  ],
