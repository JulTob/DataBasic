  "assumptions": [
    {
      "id": "d8aaaeb5-2af3-4238-a44e-22e388a53caa",
      "kind": "enunciado",
      "text": "Un empleado trabaja en una única sala y un paciente está en una única sala; en una sala hay varios de cada.",
      "elementId": "f8fba50d-3e8f-4aa5-a9c7-5354da2a9515"
    },
    {
      "id": "46d8f02e-b0a5-4a28-91fb-452b9a97ff50",
      "kind": "supuesto",
      "text": "Una sala puede no tener todavía personal ni pacientes: participación (0,N).",
      "elementId": "f8fba50d-3e8f-4aa5-a9c7-5354da2a9515"
    },
    {
      "id": "d2211d6c-05f8-479c-b0fc-45627a19a06b",
      "kind": "perdida",
      "text": "Que los pacientes internados no superen las camas de la sala no se puede expresar con claves.",
      "elementId": "59fe22b4-a28a-42aa-938d-60842f0e62ab"
    }
  ],
