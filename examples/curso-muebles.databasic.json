  "assumptions": [
    {
      "id": "5b865a81-f1a1-49f8-b636-98894f72e4d6",
      "kind": "enunciado",
      "text": "Una pieza forma parte de varios muebles y un mueble está formado por una o más piezas, con las unidades de cada una.",
      "elementId": "f55b1d97-b0cd-431f-8749-5cbf6baa5a7f"
    },
    {
      "id": "4841a46c-e6cf-47a0-a8bf-3bc2260f92e3",
      "kind": "enunciado",
      "text": "La estantería se identifica por pasillo y altura: clave compuesta.",
      "elementId": "d32f9672-a237-4ed8-a1d6-f36638335dc8"
    },
    {
      "id": "2dfc2a3d-c8ac-4725-ad26-49dad72aa2d8",
      "kind": "enunciado",
      "text": "Los muebles de una sola pieza se encuentran en una o más estanterías: subclase Mueble_una_pieza (especialización parcial de Mueble) con participación (1,N) en Almacena.",
      "elementId": "3634966f-91de-404c-8e14-21b1514ddeec"
    },
    {
      "id": "8e4e229d-33bc-4bcc-ad0e-a79218fb0927",
      "kind": "supuesto",
      "text": "Una pieza puede estar en el catálogo sin formar parte todavía de ningún mueble: participación (0,N) en Compone.",
      "elementId": "2eeb7d3b-36fe-4493-be13-a2bfc80178f7"
    },
    {
      "id": "d4073ff5-9058-4e55-b386-61930390b202",
      "kind": "supuesto",
      "text": "Una estantería puede estar vacía: participación (0,N) en Almacena.",
      "elementId": "d32f9672-a237-4ed8-a1d6-f36638335dc8"
    },
    {
      "id": "8d678a2d-7458-4204-bff2-a2f701c0d3f9",
      "kind": "supuesto",
      "text": "Las unidades valen al menos 1: si un mueble no tiene unidades en una estantería, no hay fila en Almacena.",
      "elementId": "8bd51e46-89c6-4d46-a83c-8a331827b08e"
    },
    {
      "id": "e43c1f8b-d894-4d06-bb04-e840c2d64bae",
      "kind": "perdida",
      "text": "Que Mueble_una_pieza contenga exactamente los muebles con una sola pieza depende de contar sus filas en Compone: no se impone con claves.",
      "elementId": "3634966f-91de-404c-8e14-21b1514ddeec"
    }
  ],
