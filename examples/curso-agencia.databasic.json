  "assumptions": [
    {
      "id": "c96afeb6-aa34-4088-a252-4a5e266a54b3",
      "kind": "enunciado",
      "text": "Los viajes se identifican por un código único.",
      "elementId": "338d4888-d051-45d7-9219-acba92b53d1e"
    },
    {
      "id": "19dbf95b-c416-4e51-b495-098e577c3380",
      "kind": "enunciado",
      "text": "Un agente gestiona muchas reservas y cada reserva la gestiona un único agente.",
      "elementId": "51eadad6-8aec-4827-ae1f-ea300e3be1e6"
    },
    {
      "id": "5bfe6c17-47f5-406d-897e-17ad63752bfc",
      "kind": "supuesto",
      "text": "La reserva es una entidad con código propio: tiene atributos y participa en Gestiona, cosa que una relación Cliente–Viaje no podría hacer sin agregación.",
      "elementId": "70b4e183-a103-4521-862e-a8a8d43dba83"
    },
    {
      "id": "52133fdf-de64-4b77-bbaa-c24f69cb198e",
      "kind": "supuesto",
      "text": "Los teléfonos del cliente son un atributo multivaluado.",
      "elementId": "7af62ba0-3077-4ef5-9734-38319d5a4054"
    },
    {
      "id": "d714910b-8bf9-481e-ab9c-2674f62b5eb9",
      "kind": "supuesto",
      "text": "Todo empleado es agente o administrativo, nunca ambos: especialización total y disjunta.",
      "elementId": "83994105-fa08-4ac2-8423-3793a3e37f3c"
    },
    {
      "id": "b383d96a-3875-4b9c-88d8-3c1cdcbbb43c",
      "kind": "supuesto",
      "text": "El código de empleado del agente es único: clave alternativa.",
      "elementId": "c39b139a-e9c3-494d-8ad7-5b7f8142a2fb"
    },
    {
      "id": "71240f1a-a84a-4b9a-b966-3a9c22703026",
      "kind": "perdida",
      "text": "Que las plazas reservadas de un viaje no superen su capacidad no se puede expresar (el enunciado no da la capacidad).",
      "elementId": "70b4e183-a103-4521-862e-a8a8d43dba83"
    }
  ],
