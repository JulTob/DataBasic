  "assumptions": [
    {
      "id": "79d18b5c-d43d-42c6-b5ba-b150df625a5c",
      "kind": "enunciado",
      "text": "Los viajes se identifican por un código único.",
      "elementId": "d42cdc9c-ba92-48f7-be4e-54f7afb0cfd8"
    },
    {
      "id": "59fbf4d9-b26b-4307-86f3-c6cd8957e9be",
      "kind": "enunciado",
      "text": "Un agente gestiona muchas reservas y cada reserva la gestiona un único agente.",
      "elementId": "37d5ec42-44f1-41a4-82bb-59f632b5e28d"
    },
    {
      "id": "b565e4bc-afbf-4f69-8500-b2d7c78ca77a",
      "kind": "supuesto",
      "text": "La reserva es una entidad con código propio: tiene atributos y participa en Gestiona, cosa que una relación Cliente–Viaje no podría hacer sin agregación.",
      "elementId": "7a91310f-e857-4daf-8da9-488c8192cb1c"
    },
    {
      "id": "0a392c28-3042-437f-84bf-7af25f2b6a94",
      "kind": "supuesto",
      "text": "Los teléfonos del cliente son un atributo multivaluado.",
      "elementId": "b9a3c1a3-29df-4fb0-bf6b-527aef207fba"
    },
    {
      "id": "c6ff3ea8-99ec-4907-83b0-32e25e5fd48c",
      "kind": "supuesto",
      "text": "Todo empleado es agente o administrativo, nunca ambos: especialización total y disjunta.",
      "elementId": "ea9c68cf-102a-41f3-9010-31d755f82730"
    },
    {
      "id": "44ac8d76-fcca-44e3-bd3c-b249399857f0",
      "kind": "supuesto",
      "text": "El código de empleado del agente es único: clave alternativa.",
      "elementId": "0e7d5d80-f352-4cb6-9815-625a61414b84"
    },
    {
      "id": "0bc76234-a8f0-47f2-a4ae-f1beec007987",
      "kind": "perdida",
      "text": "Que las plazas reservadas de un viaje no superen su capacidad no se puede expresar (el enunciado no da la capacidad).",
      "elementId": "7a91310f-e857-4daf-8da9-488c8192cb1c"
    }
  ],
