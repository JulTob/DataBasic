  "assumptions": [
    {
      "id": "ebed91af-6858-4ec7-90d9-073b7f9084c5",
      "kind": "enunciado",
      "text": "Los viajes se identifican por un código único.",
      "elementId": "1d406377-65a8-402e-9618-c68a27f799e8"
    },
    {
      "id": "f89e746b-edea-442a-b3f5-4d01de37ead4",
      "kind": "enunciado",
      "text": "Un agente gestiona muchas reservas y cada reserva la gestiona un único agente.",
      "elementId": "9e031425-082e-4db5-bcc4-7d2f49401d9a"
    },
    {
      "id": "7639ae36-b539-4944-9a85-0e1c11e81bb8",
      "kind": "supuesto",
      "text": "La reserva es una entidad con código propio: tiene atributos y participa en Gestiona, cosa que una relación Cliente–Viaje no podría hacer sin agregación.",
      "elementId": "5d7826fe-e265-4958-9d72-8b3bfda89113"
    },
    {
      "id": "746436fc-7a0a-4578-ba69-076a24eb2b73",
      "kind": "supuesto",
      "text": "Los teléfonos del cliente son un atributo multivaluado.",
      "elementId": "53e62adc-d631-4090-9606-e6517b5f8927"
    },
    {
      "id": "cb662743-d537-4c52-a884-f5aa8eef0776",
      "kind": "supuesto",
      "text": "Todo empleado es agente o administrativo, nunca ambos: especialización total y disjunta.",
      "elementId": "e95cc53a-9c17-40da-897c-889938081da9"
    },
    {
      "id": "c5c666e3-daa8-408b-8a15-3e1f7275e214",
      "kind": "supuesto",
      "text": "El código de empleado del agente es único: clave alternativa.",
      "elementId": "856ec052-5657-456b-b17f-a18201f0ebc9"
    },
    {
      "id": "59116a2e-f107-4a3b-9b63-74ed6bc69e6f",
      "kind": "perdida",
      "text": "Que las plazas reservadas de un viaje no superen su capacidad no se puede expresar (el enunciado no da la capacidad).",
      "elementId": "5d7826fe-e265-4958-9d72-8b3bfda89113"
    }
  ],
