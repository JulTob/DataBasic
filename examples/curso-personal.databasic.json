  "assumptions": [
    {
      "id": "0669dbe8-c506-480d-bf91-56c5317a67d1",
      "kind": "enunciado",
      "text": "Hay dos clasificaciones independientes del mismo empleado: por su vínculo (funcionario o laboral) y por su función (docencia o servicios).",
      "elementId": "941e941c-350d-4686-9987-e56366e6985c"
    },
    {
      "id": "c19d4b2e-5f69-4a96-997f-ad9c784c0f36",
      "kind": "supuesto",
      "text": "Cada clasificación es total y disjunta: todo empleado tiene exactamente un vínculo y exactamente una función.",
      "elementId": "941e941c-350d-4686-9987-e56366e6985c"
    },
    {
      "id": "58e7ef37-9456-423e-a6b3-fecfdee3d96b",
      "kind": "perdida",
      "text": "Que cada empleado aparezca en una y solo una subtabla de cada clasificación no lo imponen las claves ajenas; queda documentado.",
      "elementId": "941e941c-350d-4686-9987-e56366e6985c"
    }
  ],
